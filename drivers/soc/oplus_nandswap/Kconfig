config NANDSWAP
	bool "Oplus NandSwap swap extension"
	default n
	help
	  Oplus NandSwap: dedicated swap-area management with nswapoutd /
	  nswapind / nswapdropd kernel threads, /proc/nandswap control
	  (fn_enable, dev_life, swap_ctl, swap_limit, life_protect,
	  stat_info), and swap-device tagging via the SWAP_NANDSWAP_PRIO
	  (2020) swap priority. Kernel-side port from the Oplus/realme
	  atoll msm-4.14 vendor sources.

config NANDSWAP_DEBUG
	bool "nandswap debug"
	depends on F2FS_FS
	default n
	help
	  nandswap debug
