# EROFS (Enhanced Read-Only File System)
# ----------------------------------------------------------------------
# EROFS is the read-only filesystem Google uses for the Android system
# partitions.  Enabling it here lets the phone mount EROFS based vendor/
# system images and any EROFS formatted loop/partition the user creates.
#
# Compression is the fixed-sized-output LZ4 variant supported by this
# EROFS backport. Fast symlinks also validate inline offsets and block bounds.

CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# LZ4 is the only compressor wired up in this EROFS revision.
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_LZ4HC_COMPRESS=y

# Per-CPU decompression kthreads: off by default, they cost a kthread per
# CPU even when nothing is mounted.
CONFIG_EROFS_FS_PCPU_KTHREAD=n
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=n
CONFIG_EROFS_FS_DEBUG=n
