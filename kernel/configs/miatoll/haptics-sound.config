# Haptics & Sound tuning — miatoll (SM6250 / Atoll)
# ================================================

# ── Audio: HRTIMER for precise ALSA timing ──
# Replaces the default jiffies-based timer with hrtimer for lower
# audio latency and more accurate period timing. Reduces jitter
# on compressed offload and PCM playback paths.
CONFIG_SND_HRTIMER=y

# ── Audio: Dynamic minors for more PCM devices ──
# Already enabled, reinforce for many concurrent streams.
CONFIG_SND_DYNAMIC_MINORS=y

# ── Audio: PCM timer for precise period interrupts ──
CONFIG_SND_PCM_TIMER=y

# ── Audio: USB Audio (external DACs, USB headsets) ──
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ── Audio: Compress offload (hardware decoder) ──
# Already enabled, reinforce. Lets the DSP decode audio instead of CPU.
CONFIG_SND_COMPRESS_OFFLOAD=y
CONFIG_SND_SOC_COMPRESS=y

# ── Haptics: Input force-feedback (game vibration) ──
CONFIG_INPUT_FF_MEMLESS=y

# ── Haptics: AW8624 (primary haptic driver) ──
# Already enabled. Auto-calibration runs at boot.
CONFIG_AW8624_HAPTIC=y

# ── Haptics: DRV2624 (secondary haptic driver) ──
# Already enabled. Supports LRA and ERM motors with auto-calibration.
CONFIG_DRV2624_HAPTIC=y