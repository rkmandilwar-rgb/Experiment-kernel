# Haptics & sound tuning — miatoll (SM6250 / Atoll)
# ================================================
# Two layers, both needed for "good vibration":
#
#  1. the drivers themselves, plus the source tweaks in
#     drivers/misc/aw8624_haptic/ (vibrator workqueue on WQ_HIGHPRI so buzz
#     onset is not queued behind ordinary work, and a validated 0..128
#     "ulevel" gain ceiling exposed over sysfs), and
#  2. the options below: the force-feedback input layer, and the ALSA
#     hrtimer/compress-offload paths that haptics-via-audio and any
#     feedback-aware game use.

# ── Haptics: input force-feedback (games, controllers) ──
CONFIG_INPUT_FF_MEMLESS=y

# ── Haptics: AW8624 (primary vibrator driver on miatoll) ──
CONFIG_AW8624_HAPTIC=y

# ── Haptics: DRV2624 (secondary / fallback compatible part) ──
CONFIG_DRV2624_HAPTIC=y

# ── Audio: HRTIMER backend for precise ALSA timing ──
# Replaces the jiffies-based timer with hrtimers: lower audio latency and
# more accurate period timing, less jitter on PCM and compress-offload.
CONFIG_SND_HRTIMER=y

# ── Audio: dynamic minors for many concurrent PCM streams ──
CONFIG_SND_DYNAMIC_MINORS=y

# ── Audio: PCM timer for precise period interrupts ──
CONFIG_SND_PCM_TIMER=y

# ── Audio: USB audio (external DACs, USB headsets) ──
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ── Audio: compress offload — the DSP decodes instead of the CPU ──
CONFIG_SND_COMPRESS_OFFLOAD=y
CONFIG_SND_SOC_COMPRESS=y

# Sysfs knobs once flashed (root).  The attribute group hangs off the I2C
# device, and miatoll wires the AW8624 at address 0x5A
# (cust-atoll-idp.dtsi: aw8624_haptic@5A):
#   /sys/bus/i2c/devices/*-005a/          (or /sys/devices/.../4-005a/)
#     level   - hardware strength for the next buzz
#     gain    - driver gain register
#     ulevel  - user ceiling, 0..128, multiplied into every gain write
#   echo 96  > .../ulevel   # noticeably softer buzz, better battery
#   echo 128 > .../ulevel   # full strength (driver default)
