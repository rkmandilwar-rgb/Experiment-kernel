# Haptics & Sound tuning — miatoll (SM6250 / Atoll)
# ================================================
# All of this is baked directly into vendor/xiaomi/miatoll_defconfig and
# the driver source; this fragment mirrors it for documentation.

# ── Audio: HRTIMER for precise ALSA timing ──
# Replaces the jiffies-based timer with hrtimer for lower audio latency
# and more accurate period timing; less jitter on compress-offload and
# PCM playback paths.
CONFIG_SND_HRTIMER=y

# ── Audio: Dynamic minors for many concurrent PCM streams ──
CONFIG_SND_DYNAMIC_MINORS=y

# ── Audio: PCM timer for precise period interrupts ──
CONFIG_SND_PCM_TIMER=y

# ── Audio: USB Audio (external DACs, USB headsets) ──
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ── Audio: Compress offload (DSP decodes instead of CPU) ──
CONFIG_SND_COMPRESS_OFFLOAD=y
CONFIG_SND_SOC_COMPRESS=y

# ── Haptics: Input force-feedback (game vibration) ──
CONFIG_INPUT_FF_MEMLESS=y

# ── Haptics: AW8624 (primary driver, bound via cust-atoll-idp.dtsi) ──
# The driver's vibrator workqueue now runs WQ_HIGHPRI so buzz onset is
# not queued behind normal-priority work (drivers/misc/aw8624_haptic).
CONFIG_AW8624_HAPTIC=y

# ── Haptics: DRV2624 (secondary/fallback compatible) ──
CONFIG_DRV2624_HAPTIC=y

# AW8624 driver exposes a validated 0..128 ulevel gain ceiling via sysfs.
