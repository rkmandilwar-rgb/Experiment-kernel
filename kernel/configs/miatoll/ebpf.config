# eBPF (extended Berkeley Packet Filter) support
# ----------------------------------------------------------------------
# Full eBPF support for miatoll (non-GKI, 4.14): the BPF syscall, the
# arm64 JIT, cgroup-bpf, tracing (kprobe/uprobe/tracepoint) attach types,
# and the networking hooks (cls_bpf, act_bpf, lwtunnel, XDP-ish sk_filter).
#
# Notes:
#   * CONFIG_BPF_JIT_ALWAYS_ON is required on arm64 for the JIT hardened
#     (read-only) image, keep it.
#   * eBPF tracing needs kprobes/uprobes + ftrace syscall tracing; that is
#     what most BPF tooling (bcc, bpftrace-like helpers, tc filters) uses.
#   * CONFIG_BPFILTER (the user-mode-helper iptables server) is a 5.x-era
#     stub and does not exist on 4.14 - deliberately not listed here.

# Core
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_BPF_PRELOAD=n

# BPF compatibility spoof; kernel/sys.c limits it to selected root processes.
CONFIG_FAKE_UNAME_5_10=y

# Tracing / attach types
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KRETPROBES=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_TRACING=y
CONFIG_TRACING_SUPPORT=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_REGS=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_TRACEPOINTS=y
# (not present in Linux 4.14) CONFIG_TRACE_EVENT_INJECT
CONFIG_PROBE_EVENTS=y
# (not present in Linux 4.14) CONFIG_KPROBE_EVENTS_ON_NOTRACE

# Networking hooks
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y

# Kernel self tests / debug (off - they are not useful on a phone)
CONFIG_TEST_BPF=n
