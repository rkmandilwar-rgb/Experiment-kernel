# eBPF (extended Berkeley Packet Filter) support
# ----------------------------------------------------------------------
# Full eBPF support for miatoll (non-GKI, 4.14): the BPF syscall, the
# arm64 JIT, cgroup-bpf, tracing (kprobe/uprobe/tracepoint) attach types,
# and the networking hooks (cls_bpf, act_bpf, lwtunnel, XDP-ish sk_filter).
#
# Notes:
#   * CONFIG_BPF_JIT_ALWAYS_ON is required on arm64 for the JIT hardened
#     (read-only) image, keep it.
#   * The whole tracing/probe pack is OFF for build 184. This tree was the
#     only miatoll kernel in the reference set with dynamic ftrace and kprobes
#     enabled:
#         kinesis (A17, same SoC)       no FUNCTION_TRACER, no DYNAMIC_FTRACE,
#                                       no kprobes
#         crDroid sm6250 16.0 (full)    "# CONFIG_FUNCTION_TRACER is not set"
#         LineageOS sm6250              same
#     Dynamic ftrace rewrites kernel text in ftrace_init(), i.e. before init
#     runs, and this is an LTO (CONFIG_LTO_CLANG/THINLTO) build - recordmcount
#     plus LTO is a long-standing fragile combination. A single mis-patched
#     call site hangs the device exactly at the boot logo, which is the bug we
#     are chasing. BPF core, the arm64 JIT, cgroup-bpf and every networking
#     hook stay enabled; only the tracing/probe attach types go away.
#   * CONFIG_BPFILTER does exist in this tree (net/bpfilter/Kconfig, used by
#     net/ipv4/ip_sockglue.c) and the vendor defconfig already carries
#     "# CONFIG_BPFILTER is not set": it is a user-mode-helper iptables
#     front end that we deliberately keep off, not something the tree lacks.

# Core
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_BPF_PRELOAD=n

# Tracing / attach types: all OFF for the A17 boot bisect (see note above)
# CONFIG_TRACING is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_FTRACE_SYSCALLS is not set
# CONFIG_KPROBES is not set
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_KRETPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_PROBE_EVENTS is not set
CONFIG_PERF_EVENTS=y
CONFIG_TRACEPOINTS=y

# Networking hooks
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_LWTUNNEL=y
CONFIG_LWTUNNEL_BPF=y

# Kernel self tests / debug (off - they are not useful on a phone)
CONFIG_TEST_BPF=n
