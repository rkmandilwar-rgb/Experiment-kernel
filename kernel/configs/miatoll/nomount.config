# NoMount 21 — VFS path redirection framework (no mounts, no /proc/mounts
# pollution). Kernel side: fs/nomount/ (vendored from maxsteeel/nomount,
# kernel/src @ master). Userspace talks to it through the kernel keyring
# (add_key) from the "nomount" key type, so CONFIG_KEYS must stay on.
CONFIG_NOMOUNT=y
