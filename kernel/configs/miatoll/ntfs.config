# NTFS support
# ----------------------------------------------------------------------
# Two drivers are enabled:
#
#   CONFIG_NTFS_FS   - the legacy in-tree NTFS driver.  It only ever had
#                      read support plus a (dangerous) partial write path,
#                      but it owns the "ntfs" filesystem type, and some
#                      legacy tools still rely on it.
#   CONFIG_NTFS3_FS  - the Paragon ntfs3 driver (backported into fs/ntfs3).
#                      Full read/write: normal, sparse and compressed
#                      files, journal replaying, xattrs and POSIX ACLs.
#                      Filesystem type on mount is "ntfs3", so it coexists
#                      with the legacy driver: `mount -t ntfs3 /dev/sda1`.

CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_NTFS_DEBUG=n

CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
# 64-bit clusters break Windows interoperability, keep it off.
CONFIG_NTFS3_64BIT_CLUSTER=n

# UTF-8 is what Windows actually writes, make it the default translation.
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
