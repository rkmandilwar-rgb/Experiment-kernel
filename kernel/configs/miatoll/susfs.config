# KernelSU-Next + SUSFS v2.3.0 (non-GKI / 4.14)
#
# SUSFS is the KernelSU-Next addon root-hiding layer: it hides sus paths,
# mounts, kstat/statfs values, /proc/<pid>/maps entries, /proc/cmdline and the
# ksu/susfs symbols from /proc/kallsyms.  The kernel half lives in fs/susfs.c
# (+ include/linux/susfs*.h); the supercalls that drive it are dispatched by
# drivers/kernelsu/supercall/dispatch.c.  The kernel and the KernelSU driver
# must be the same susfs generation -- v2.3.0 here.
#
# Hooking: 4.14 has no pt_regs-based syscall ABI (< 4.17), so the syscall-table
# hook is not available; KernelSU-Next is built with the kprobes/tracepoint
# hook instead.
CONFIG_KSU=y
CONFIG_KSU_KPROBES_HOOK=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y

# --- SUSFS v2.3.0 ---
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# sus_memfd is experimental, needs the __cleanup() infrastructure backport and
# is reverted upstream too - keep it off.
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set

# --- what the susfs kernel half needs from the rest of the tree ---
# fs/susfs.c hooks the FUSE inode behind /sdcard (get_fuse_inode())
CONFIG_FUSE_FS=y
# the /sdcard/Android monitor walks fsnotify marks
CONFIG_FSNOTIFY=y
CONFIG_INOTIFY_USER=y
# try_umount / path handling
CONFIG_SECURITY_SELINUX=y
