# Touch tuning — miatoll (SM6250 / Atoll), conservative
# =====================================================
# Three panels ship across the miatoll family (curtana / gram / joyeuse /
# excalibur): FocalTech FT8756 over SPI and Novatek NT36xxx over SPI.  This
# fragment pins exactly those two drivers plus the Xiaomi touch-properties
# node, and keeps everything that is not on the device out of the build so
# two drivers never fight over the same bus or the same panel.
#
# What "conservative" means here, concretely:
#
#   * Only the panel drivers the device actually has are enabled; the
#     in-tree "generic" FocalTech driver (TOUCHSCREEN_FTS, a different,
#     older driver for the same vendor) is explicitly disabled because both
#     it and TOUCHSCREEN_FTS_SPI define the same platform driver/IRQ names
#     and a panel must be claimed by exactly one of them.
#   * The Novatek C3X variant stays off: it is a different ROM/IC revision
#     of the same 36xxx family and probing it on a non-C3X panel can leave
#     the controller stuck in host-download mode.
#   * No debug/trace plumbing (FTS_DEBUG_EN, the vendor's test mode and the
#     ESD polling loop are all left at their driver defaults): they cost CPU
#     time in the input path and change panel behaviour, which is exactly
#     what a "conservative" tuning should not do.
#   * The touchscreen-as-an-input-device path stays fully enabled
#     (INPUT_EVDEV, INPUT_TOUCHSCREEN, TOUCHSCREEN_PROPERTIES) so gestures,
#     cover detection and the ROM's own touch HAL keep working.
#
# The short CPU boost that makes taps feel immediate is not configured here;
# it lives in cpu-boost.c and is enabled by the scheduler pack
# (CONFIG_CPU_BOOST=y, default 1.4 GHz for 40 ms after an input event, at
# most once per 150 ms).  Its knobs are runtime-tunable:
#   /sys/module/cpu_boost/parameters/input_boost_freq
#   /sys/module/cpu_boost/parameters/input_boost_ms

# ── Input core ──
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_EVDEV=y

# ── Panel drivers present on miatoll ──
CONFIG_TOUCHSCREEN_FTS_SPI=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
# CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_C3X is not set
CONFIG_TOUCHSCREEN_PROPERTIES=y

# ── Same-vendor / other-panel drivers that must NOT be built ──
# CONFIG_TOUCHSCREEN_FTS is not set

# ── Haptics-adjacent input bits used by the touch stack ──
# Force feedback is what games/controllers ask for; the vibrator itself is
# AW8624/DRV2624 (see haptics-sound.config).
CONFIG_INPUT_FF_MEMLESS=y
