# Toolchain / code-generation features (Polly + Clang LTO + aggressive inlining)
# ============================================================================
# These stayed ON after the A17 boot investigation, on purpose. The evidence:
#
#   kinesis  clarencelol/kernel_xiaomi_sm6250 @ kinesis-v29
#            (same SoC, Android 17, KernelSU built in, boots)
#              CONFIG_LTO_CLANG=y
#              CONFIG_LLVM_POLLY=y
#              CONFIG_THINLTO=y
#
# so ThinLTO + Polly on this device are NOT the reason a build hangs on the
# boot logo - a kernel with exactly this codegen boots A17 on miatoll. An
# earlier draft of this file dropped the whole pack on that theory; that was
# wrong and was reverted before it ever shipped.
#
# The build-184 change is in ebpf.config instead: the dynamic-ftrace / kprobe
# text-patching pack is off, because no other miatoll kernel enables it and it
# rewrites kernel text in ftrace_init() before init starts.
#
#   POLLY    - polyhedral loop optimizer.
#   LTO      - whole-kernel link-time optimization with ld.lld.
#   THINLTO  - ThinLTO variant of the above.
#   INLINE   - raises inliner/unroller thresholds (kinesis parity).

# ── Polly ──
CONFIG_LLVM_POLLY=y

# ── Clang LTO (ThinLTO) ──
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y

# ── Aggressive inlining ──
CONFIG_INLINE_OPTIMIZATION=y
