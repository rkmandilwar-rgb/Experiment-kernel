# Kali NetHunter support
# ----------------------------------------------------------------------
# Everything below follows the official NetHunter kernel configuration
# guide (https://www.kali.org/docs/nethunter/) for 4.x kernels:
#
#   * USB Modem (CDC ACM)            - Proxmark and similar serial devices
#   * USB Gadget support (configfs)  - BadUSB / HID / CDC Ethernet /
#                                      Mass Storage / RNDIS attacks
#   * CAN bus subsystem              - CARsenal (can-utils, slcan, vcan)
#   * NFS client and server          - mounting remote shares inside Kali
#   * USB serial converters          - CH341, FTDI, PL2303, CP210x ...
#   * mac80211 + USB Wi-Fi adapters  - monitor mode / packet injection with
#                                      external adapters (ath9k_htc,
#                                      carl9170, zd1211rw, rtl8187,
#                                      rt2800usb, rt73usb, mt7601u)
#   * Bluetooth                      - Bluetooth Arsenal (RFCOMM TTY, BNEP,
#                                      HIDP)
#   * USB DVB / RTL-SDR              - SDR tools
#   * usbmon                         - USB traffic sniffing
#
# Monitor mode on the *internal* Qualcomm WLAN chip additionally needs a
# patched vendor driver (qcacld-3.0); that is a firmware/vendor matter and
# is not something a defconfig can provide.  What this fragment does is
# make every *external* USB adapter work, which is what NetHunter's
# "wireless attacks" actually use on most devices.

# --- USB Modem (CDC ACM), required for Proxmark and friends -------------
CONFIG_USB_ACM=y
CONFIG_USB_WDM=y

# --- USB Gadget support (configfs) --------------------------------------
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_SUBSET=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_F_EEM=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_F_HID=y

# --- USB traffic monitoring ---------------------------------------------
CONFIG_USB_MON=y

# --- Host side USB networking (USB ethernet / RNDIS / tethering) --------
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_NET1080=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_SMSC75XX=y
CONFIG_USB_NET_SMSC95XX=y
# (RTL8150/8152 not present in this 4.14 tree's Kconfig)
# CONFIG_USB_NET_RTL8150=n
# CONFIG_USB_NET_RTL8152=n
CONFIG_USB_NET_CDC_MBIM=y

# --- USB serial converters (CAN adaptors, Proxmark, Arduino, ...) -------
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_SIERRAWIRELESS=n
CONFIG_USB_SERIAL_QUALCOMM=n

# --- CAN bus subsystem (CARsenal) ---------------------------------------
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_SLCAN=m
CONFIG_CAN_DEV=y
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_LEDS=y
CONFIG_CAN_GRCAN=y
CONFIG_CAN_XILINXCAN=y
CONFIG_CAN_C_CAN=y
CONFIG_CAN_CC770=y
CONFIG_CAN_IFI_CANFD=y
CONFIG_CAN_M_CAN=y
CONFIG_CAN_SJA1000=y
CONFIG_CAN_SOFTING=y
CONFIG_CAN_HI311X=y
CONFIG_CAN_MCP251X=y
CONFIG_CAN_EMS_USB=y
CONFIG_CAN_ESD_USB2=y
CONFIG_CAN_GS_USB=y
CONFIG_CAN_KVASER_USB=y
CONFIG_CAN_PEAK_USB=y
CONFIG_CAN_8DEV_USB=y
CONFIG_CAN_MCBA_USB=y

# --- Virtual sockets + netlink socket monitoring ------------------------
CONFIG_VSOCKETS=y

# --- Bluetooth Arsenal --------------------------------------------------
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
# (BT_HCIUSB not present in this tree - BT_HCIBTUSB is the replacement)
CONFIG_BT_HCIBTUSB=y
# Broadcom / Realtek USB dongle protocol support (needed for firmware
# download on those dongles).
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTSDIO=n
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
# The internal WCN3990 Bluetooth speaks the QCA protocol over UART; some
# ROMs attach it with hciattach's "qca" mode instead of plain "h4" (this
# also pulls in the btqca firmware helper). Keep both protocols available.
CONFIG_BT_HCIUART_QCA=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# --- NFS client and server ----------------------------------------------
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_NFS_V4_1=y
CONFIG_NFS_V4_2=y
CONFIG_NFS_SWAP=n
CONFIG_ROOT_NFS=y
CONFIG_NFSD=y
CONFIG_NFSD_V2_ACL=n
CONFIG_NFSD_V3=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_V4_SECURITY_LABEL=y
CONFIG_NFSD_BLOCKLAYOUT=n
CONFIG_NFSD_SCSILAYOUT=n
CONFIG_NFSD_FLEXFILELAYOUT=n
CONFIG_LOCKD=y
CONFIG_LOCKD_V4=y
CONFIG_SUNRPC=y
CONFIG_SUNRPC_GSS=n
CONFIG_GRACE_PERIOD=y
CONFIG_EXPORTFS=y

# --- Wireless: mac80211 + external USB Wi-Fi adapters -------------------
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_CFG80211_CERTIFICATION_ONUS=n
# Keep the vendor's built-in regulatory database (y in the base defconfig):
# without it, country-code and cellular hints need a userspace CRDA helper
# that Android does not run, leaving the device on the restrictive world
# regulatory domain (fewer usable 5 GHz channels).
CONFIG_CFG80211_INTERNAL_REGDB=y
CONFIG_NL80211_TESTMODE=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_MINSTREL_HT=y
CONFIG_MAC80211_RC_DEFAULT="minstrel_ht"
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_LEDS=y
CONFIG_MAC80211_HWSIM=n
# (WIRELESS_HOTKEY not present in this 4.14 tree)

# Atheros
CONFIG_ATH_COMMON=y
CONFIG_ATH9K_HW=y
CONFIG_ATH9K_COMMON=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH9K_HTC_DEBUGFS=y
CONFIG_CARL9170=y
CONFIG_CARL9170_LEDS=y

# Ralink / MediaTek (rt2x00)
CONFIG_RT2X00=y
CONFIG_RT2X00_LIB=y
CONFIG_RT2X00_LIB_USB=y
CONFIG_RT2X00_LIB_FIRMWARE=y
CONFIG_RT2X00_LIB_CRYPTO=y
CONFIG_RT2X00_LIB_LEDS=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_RT2800_LIB=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_MT7601U=y

# Realtek
CONFIG_RTL8187=y
CONFIG_RTL8187_LEDS=y
CONFIG_RTL8XXXU=y

# ZyDAS
CONFIG_ZD1211RW=y

# --- SDR (RTL-SDR / DVB-T dongles used by kalibrate / gqrx / rtl_sdr) ---
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
# (MEDIA_RC_SUPPORT already implied by RC_CORE in this tree)
CONFIG_RC_CORE=y
CONFIG_DVB_CORE=y
CONFIG_DVB_USB_V2=y
CONFIG_DVB_USB_RTL28XXU=y
CONFIG_MEDIA_ATTACH=n
CONFIG_VIDEO_DEV=n
CONFIG_VIDEO_V4L2=n
CONFIG_DVB_MAX_ADAPTERS=8

# --- Misc tools ---------------------------------------------------------
CONFIG_PACKET=y
# (PACKET_MMAP not a separate option in this kernel; the feature is
#  always compiled into net/packet.c when CONFIG_PACKET=y)
CONFIG_LIB80211=n
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_TUN=y
CONFIG_TAP=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_MROUTE=y
CONFIG_IP_PIMSM_V1=y
CONFIG_IP_PIMSM_V2=y
