# Wi-Fi tuning — miatoll (WCN3990/QCA6390 through qcacld-3.0)
# ===========================================================
# The internal Wi-Fi chip is driven by the in-tree Qualcomm stack
# (drivers/staging/qcacld-3.0 + qca-wifi-host-cmn, CONFIG_QCA_CLD_WLAN=y),
# with cfg80211/mac80211 on top and CNSS_GENL as the userspace channel.
#
# What this fragment tunes:
#   * statically compiled regulatory database — Android has no CRDA and the
#     vendor service expects the rules to be in the kernel, so channels and
#     TX power limits are correct out of the box;
#   * NL80211_TESTMODE — the vendor command channel: needed for monitor mode
#     / injection tooling (NetHunter, nexmon-class setups) and for the HAL's
#     test commands;
#   * cfg80211 wireless extensions, still used by older Wi-Fi tools;
#   * mac80211 options for external (USB) adapters: minstrel_ht rate control
#     for throughput, mesh, LED triggers;
#   * explicit vendor extras.
#
# Deliberately NOT enabled:
#   CONFIG_WLAN_FEATURE_RX_WAKELOCK — vendors use it to hold a wakelock from
#   the first RX to the last TX; it improves throughput in benchmarks at a
#   real cost in idle battery. Kept off.
#   CONFIG_CFG80211_DEBUGFS / CONFIG_MAC80211_DEBUGFS — they need DEBUG_FS,
#   which this kernel does not enable.

# ── Regulatory database in-kernel (no CRDA on Android) ──
CONFIG_CFG80211_INTERNAL_REGDB=y

# ── Vendor/test command channel (monitor + injection tooling) ──
CONFIG_NL80211_TESTMODE=y

# ── Legacy wireless extensions for older tools ──
CONFIG_CFG80211_WEXT=y

# ── mac80211: rate control / mesh / LED triggers ──
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_MINSTREL_HT=y
CONFIG_MAC80211_RC_DEFAULT="minstrel_ht"
CONFIG_MAC80211_MESH=y

# ── Internal Qualcomm stack + userspace channel ──
CONFIG_QCA_CLD_WLAN=y
CONFIG_QCA_CLD_WLAN_PROFILE="default"
CONFIG_CNSS_GENL=y

# ── Third-party USB Wi-Fi (mac80211 based, mirrors the NetHunter pack) ──
CONFIG_CFG80211_CERTIFICATION_ONUS=n
