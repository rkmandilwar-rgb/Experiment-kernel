# Performance & memory tuning — miatoll 4 GB stability profile (SM6250 / Atoll)
# ==================================================================
# AUTHORITATIVE policy fragment: merged last by scripts/merge-defconfig.sh,
# so these values are the final word for CI builds. Every symbol listed here
# exists in this 4.14 tree; anything the tree does not have (MEMCG_KMEM,
# ENERGY_MODEL, ...) must NOT be listed.
#
# Profile rationale for a 4 GB device:
#   * Preserve the standard Android memory path: ZRAM (LZ4, dedup on) +
#     memcg/PSI accounting. No stacked/optional memory layers.
#   * zram-first reclaim: vm.swappiness default is 100 (mm/vmscan.c) —
#     cold anon pages go to cheap compressed RAM instead of being killed.
#   * One swap page per fault (page-cluster 0, mm/swap.c) and 256 KB
#     read-ahead (VM_MAX_READAHEAD, consumed by block/blk-core.c).
#   * No KSM background scanning, no THP compaction/fragmentation, no
#     zswap/frontswap layering, no HugeTLB pool, no idle-page-tracking or
#     page-extension overhead.

# ── HZ 300 — better timer resolution for smooth UI ──
# 100 Hz = 10 ms granularity (too coarse for touch/animation).
# 300 Hz = 3.3 ms (good balance of latency vs overhead).
CONFIG_HZ_300=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ=300

# ── I/O scheduler: CFQ default ──
# UFS on this device is blk-mq, where CFQ/BFQ cannot attach (BFQ on 4.14
# is legacy-queue only): block/elevator.c already falls back to
# mq-deadline for single-hw-queue blk-mq devices.  CFQ stays the default
# for any legacy-queue device.
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_DEFAULT_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"

# ── Stable memory policy for a 4 GB device ──
# Keep the conventional Android ZRAM path; do not stack zswap on top of it.
# Disable KSM background scanning and THP to minimize reclaim/fragmentation
# risk on this 4.14 device. HugeTLB stays off (no reserved 2 MB pools).
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_KSM is not set
# CONFIG_FRONTSWAP is not set
# CONFIG_ZSWAP is not set
# CONFIG_ZPOOL is not set
# CONFIG_ZBUD is not set
# CONFIG_IDLE_PAGE_TRACKING is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_HUGETLB_PAGE is not set

# ── ZRAM ──
# Android userspace selects zram size (2 GiB on this device); LZ4 is
# the fast, low-latency compressor. Keep the existing dedup path; skip
# the experimental per-page entropy scan.
CONFIG_ZRAM=y
CONFIG_ZRAM_DEDUP=y
# CONFIG_ZRAM_ENTROPY is not set
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y

# ── Memory cgroup accounting ──
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y

# ── PSI — Pressure Stall Information ──
# Lets Android's lmkd and ActivityManager react to memory/CPU pressure
# more intelligently.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# ── Scheduler: EAS + WALT + core_ctl ──
CONFIG_SCHED_WALT=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_SCHED_MC=y

# ── CPU idle: TEO governor (registers at rating 50, outranks menu) ──
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_DT_IDLE_STATES=y

# ── F2FS with stats (if partition is f2fs) ──
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y

# ── Console loglevel — suppress debug spam for faster boot ──
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4

# ── Per-process memory visibility via /proc ──
CONFIG_PROC_PAGE_MONITOR=y

# ── Binder priority inheritance (smoother UI transitions) ──
# CONFIG_ANDROID_BINDER_IPC_SELFTEST is not set

# ── Kinesis-steal feature set (Saamitk/Kinesis@17) ─────────────────────────
# SCHED_CASS: Sultan's capacity-aware runqueue selection for big.LITTLE.
CONFIG_SCHED_CASS=y
# Faster PELT ramp (16 ms util halflife) for snappier schedutil.
CONFIG_PELT_UTIL_HALFLIFE_16=y
# CONFIG_PELT_UTIL_HALFLIFE_32 is not set
# Oplus memory-management hacks: direct_swappiness split, capped file-LRU
# ratio, zsmalloc order-3 zspages, protected-app throttle bypass.
CONFIG_OPLUS_MM_HACKS=y
# Clang toolchain excellence: Polly loop optimizer, whole-kernel LTO
# (ThinLTO), aggressive inlining, Shadow Call Stack hardening.
CONFIG_LLVM_POLLY=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
# CONFIG_LTO_NONE is not set
CONFIG_INLINE_OPTIMIZATION=y
CONFIG_SHADOW_CALL_STACK=y
# CONFIG_ROP_PROTECTION_NONE is not set
# LZ4KD fast decompressor (Huawei) as a crypto algo for zram.
CONFIG_CRYPTO_LZ4KD=y
# Kallsyms for KernelSU on non-GKI (needs DEBUG_KERNEL).
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS_ALL=y
# Small extras: Westwood TCP, EHCI/OHCI host, IR/RC core, thermal
# emulation, MMC perf profiling, force-loadable modules.
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_RC_CORE=y
CONFIG_THERMAL_EMULATION=y
CONFIG_MMC_PERF_PROFILING=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NETFILTER_XT_TARGET_HMARK=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
