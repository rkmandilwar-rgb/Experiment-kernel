# Performance tuning — balanced profile for 4 GB RAM (SM6250 / Atoll)
# ==================================================================

# ── HZ 300 — better timer resolution for smooth UI ──
# 100 Hz = 10 ms granularity (too coarse for touch/animation).
# 300 Hz = 3.3 ms (good balance of latency vs overhead).
CONFIG_HZ=300
CONFIG_HZ_300=y
# CONFIG_HZ_100 is not set

# ── I/O scheduler: CFQ default ──
# UFS on this device is blk-mq, where CFQ/BFQ cannot attach (BFQ on 4.14
# is legacy-queue only): block/elevator.c already falls back to
# mq-deadline for single-hw-queue blk-mq devices.  CFQ stays the default
# for any legacy-queue device.
CONFIG_IOSCHED_CFQ=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_DEFAULT_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"

# ── Transparent Huge Pages (madvise mode) ──
# Reduces TLB pressure for large apps (browsers, games).
# 'madvise' = only for apps that explicitly request it via madvise().
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_HAVE_ARCH_TRANSPARENT_HUGEPAGE=y

# ── KSM — Kernel Same-page Merging ──
# Scans physical memory and merges identical pages.  On 4 GB devices
# this can reclaim 100-300 MB from duplicated Java/ART pages.
CONFIG_KSM=y

# ── HugeTLBFS — needed by some ART/GPU workloads ──
CONFIG_HUGETLBFS=y

# ── ZSWAP — compressed write-back cache in front of ZRAM ──
# Keeps hot pages compressed in RAM; only cold pages go to ZRAM.
# On 4.14 zswap needs FRONTSWAP; the compressor default is baked into
# mm/zswap.c as "lz4" (the ZSWAP_COMPRESSOR_DEFAULT_* Kconfig choices
# only exist on newer kernels).
CONFIG_FRONTSWAP=y
CONFIG_ZSWAP=y
CONFIG_ZPOOL=y
CONFIG_ZBUD=y
CONFIG_CRYPTO_LZ4=y

# ── ZRAM tuning ──
CONFIG_ZRAM_DEDUP=y
CONFIG_CRYPTO_LZO=y
CONFIG_LZO_COMPRESS=y
CONFIG_LZO_DECOMPRESS=y

# ── Memory cgroup accounting (already on, reinforce) ──
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_MEMCG_KMEM=y

# ── PSI — Pressure Stall Information ──
# Lets Android's lmkd and ActivityManager react to memory/CPU pressure
# more intelligently.  (Already enabled, reinforce.)
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

# ── Scheduler: EAS + WALT + core_ctl (already on, reinforce) ──
CONFIG_SCHED_WALT=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_SCHED_MC=y

# ── CPU idle ──
CONFIG_CPU_IDLE=y
CONFIG_DT_IDLE_STATES=y

# ── F2FS with stats (if partition is f2fs) ──
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_CHECK_FS=n

# ── Console loglevel — suppress debug spam for faster boot ──
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4

# ── Per-process OOM score adjustments via /proc ──
CONFIG_PROC_PAGE_MONITOR=y

# ── Binder priority inheritance (smoother UI transitions) ──
CONFIG_ANDROID_BINDER_IPC_SELFTEST=n