# BBRv1 and BBRplus congestion control for Miatoll
# ----------------------------------------------------------------------
# BBRplus is ported from UJX6N/bbrplus's Linux 4.14.x conversion patch:
# https://github.com/UJX6N/bbrplus
# Keep classic BBRv1 and CUBIC available as alternatives, but use BBRplus
# by default. FQ is enabled and selected as the default qdisc for pacing.

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBRPLUS=y
CONFIG_TCP_CONG_CUBIC=y

CONFIG_DEFAULT_BBRPLUS=y
# CONFIG_DEFAULT_BBR is not set
# CONFIG_DEFAULT_CUBIC is not set
# CONFIG_DEFAULT_RENO is not set

# BBRplus requires fq (fair queue) for kernel packet pacing.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_PFIFO_FAST is not set
