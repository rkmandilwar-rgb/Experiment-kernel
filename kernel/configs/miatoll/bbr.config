# BBRv1 congestion control
# ----------------------------------------------------------------------
# net/ipv4/tcp_bbr.c in a 4.14 tree *is* BBRv1 (the "Bottleneck Bandwidth
# and RTT" algorithm described in the original Google paper).  BBRv2 is a
# separate module (tcp_bbr2) that only exists from 5.15 onwards, so there
# is nothing to backport: enabling CONFIG_TCP_CONG_BBR gives BBRv1.
#
# BBR cannot pace by itself on Android: it needs the fq qdisc, otherwise
# it falls back to the (much worse) internal pacing of sch_fifo.
# CONFIG_NET_SCH_FQ is therefore mandatory, not cosmetic.

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
# BIC / Westwood / HTCP are tristate with "default m", and this kernel ships
# no modules (see the module policy note in the vendor defconfig), so build
# them in - otherwise they simply do not exist at runtime.
CONFIG_TCP_CONG_BIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y

# Make BBRv1 the default for new connections (CUBIC stays compiled in and
# can still be selected per socket / per route).
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_CUBIC=n
CONFIG_DEFAULT_RENO=n
CONFIG_DEFAULT_TCP_CONG="bbr"

# BBR needs fq (fair queue) pacing.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HTB=y

# BBR relies on the generic rate estimation that sch_fq uses.
CONFIG_NET_SCHED=y
