# Performance scheduler — miatoll (SM6250 / Atoll)
# ================================================
# This fragment makes the performance scheduler stack explicit instead of
# leaving it implicit in the vendor defconfig.  Two pieces matter:
#
#   1. CASS (Capacity Aware Superset Scheduler, kernel/sched/cass.c) replaces
#      the CFS wake-up CPU selection.  Instead of clipping a task's
#      utilization at CPU capacity (which makes an overutilized little core
#      look "full" and rejects it), CASS compares *relative* utilization and
#      adds a hierarchy of tie-breakers on top (capacity fit, sync-wake
#      locality, exit latency, cache affinity).  The practical result on a
#      4x Kryo 260 + 4x Kryo 260 (2 clusters) SoC is better multi-core
#      throughput and fewer useless migrations, without the wake-up cost of
#      full EAS.  It is always active when compiled in - there is no runtime
#      switch to leave the phone accidentally on the old path.
#
#   2. WALT + schedtune + core_ctl are the vendor's own load tracking,
#      boost and hotplug machinery; they stay on because the cpufreq
#      governor, the thermal stack and userspace (perfd / a ROM's power HAL)
#      all read and write them.
#
# Conservative choices, on purpose:
#   * schedutil stays the governor for the clusters whose policy is not
#     pinned to performance by the defconfig, so both CASS and the vendor
#     governor see the same utilization signal.
#   * SCHED_AUTOGROUP stays off (Android does its own cgroup placement;
#     autogroup fights with it).
#   * SCHED_DEBUG / SCHEDSTATS stay off: they add per-task overhead for
#     interfaces this kernel's userspace does not consume.
#   * HRTICK stays on: with CASS and short bursts the tick-based
#     preemption alone makes wake-up latency spiky.

CONFIG_SCHED_WALT=y
CONFIG_SCHED_CASS=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_HRTICK=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEFAULT_USE_ENERGY_AWARE=y
# CONFIG_SCHED_AUTOGROUP is not set

# ── schedutil + the short-burst boost used by touch ──
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ATTR_SET=y
CONFIG_CPU_FREQ_TIMES=y
CONFIG_CPU_BOOST=y

# ── Vendor power/perf interfaces that userspace expects ──
CONFIG_MSM_PERFORMANCE=y

# ── devfreq governors used for the GPU / DDR on atoll ──
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_MEMLAT=y

# ── Utilization clamping (uclamp) ──
#
# Added on top of schedtune, not instead of it: the Android 17 miatoll
# powerhint writes /dev/stune/top-app/schedtune.boost, so CONFIG_SCHED_TUNE
# above must stay on. Uclamp is the newer interface (sched_setattr()
# SCHED_FLAG_UTIL_CLAMP, /proc/sys/kernel/sched_util_clamp_* and the
# cpu.uclamp.* group files); both are inert until userspace uses them.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=5
CONFIG_UCLAMP_TASK_GROUP=y
