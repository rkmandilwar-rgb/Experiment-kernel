# Bluetooth tuning — miatoll (WCN3990 over UART + external dongles)
# =================================================================
# The internal WCN3990 Bluetooth on miatoll is driven through the HCI UART
# line discipline: the vendor Bluetooth service opens the BT UART and the
# kernel switches the ldisc to "qca" (drivers/bluetooth/hci_qca.c registers
# HCI_UART_QCA).  That protocol is what carries the in-band sleep / UART
# clock control; without it the controller falls back to plain H4 framing,
# which costs power and makes reconnects flaky.
#
# The stock defconfig here does not enable the transport at all, so this
# fragment is what makes internal Bluetooth behave.
#
# Layers:
#   * QCA protocol for the internal chip (BT_HCIUART_QCA, selects BT_QCA)
#   * 3-wire (BT_HCIUART_3WIRE) and LL (BT_HCIUART_LL) framing helpers
#   * external USB dongles: btusb (BCM/RTL/QCA protocols), ath3k, bcm, intel
#   * vhci: virtual HCI, used by btmon/btsnoop capture and emulator work
#   * BNEP filters so BT tethering still works with netfilter rules
#   * RFCOMM/RFCOMM-TTY/BNEP/HIDP come in with the NetHunter fragment
#
# Debugfs-based BT tracing (CONFIG_BT_DEBUGFS) stays off on purpose:
# DEBUG_FS is disabled in this kernel, so that option cannot be selected.

# ── Internal WCN3990 over UART (hci_qca) ──
# This is the one that matters on miatoll: hci_qca registers the HCI_UART_QCA
# line-discipline protocol (in-band sleep / UART clock control).
CONFIG_BT_HCIUART_QCA=y

# ── External dongles (USB + UART) ──
# btusb protocols for USB dongles, plus the non-serdev UART protocols.
# BT_HCIUART_LL / _3WIRE / _BCM are deliberately NOT listed: in this tree
# they depend on BT_HCIUART_SERDEV (i.e. CONFIG_SERIAL_DEV_BUS), and serdev
# is kept off because the device's BT UART is claimed from userspace via the
# line discipline - handing the same UART to the serdev bus could re-bind it
# away from the vendor flow.
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_ATH3K=y

# ── Virtual HCI (btmon / btsnoop / emulation) ──
CONFIG_BT_HCIVHCI=y

# ── BNEP filtering (Bluetooth tethering + firewall) ──
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# ── Qualcomm BT power/SLIM audio plumbing (already in the vendor config,
#    repeated here so the intent is explicit) ──
CONFIG_MSM_BT_POWER=y
CONFIG_BTFM_SLIM=y
CONFIG_BTFM_SLIM_WCN3990=y
