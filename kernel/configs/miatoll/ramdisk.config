# Ramdisk / initramfs decompressors (RD_*)
# ----------------------------------------------------------------------
# Enables every initramfs decompressor that the 4.14 tree provides in
# usr/Kconfig: gzip, bzip2, lzma, xz, lzo and lz4.  (zstd is not an RD_*
# option in 4.14, so it cannot be enabled here.)
#
# Each RD_* option selects the matching DECOMPRESS_* library, so the
# decompressor code is pulled in automatically.

CONFIG_BLK_DEV_INITRD=y

CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y
