# Android 17 (API 37) compatibility for a 4.14 kernel.
#
# Measured against the trees that actually ship Android 17 on 4.14 hardware:
# LineageOS 24.0 for sm6125 (ginkgo/willow) and for the Pixel 4, plus the
# maintained miatoll A17 kernel.
#
# 1. AUDIT on.  All of them enable it.  With CONFIG_AUDIT=n SELinux compiles
#    its whole audit path out, so no "avc:" records are emitted at all and the
#    SUSFS AVC-log spoof has nothing to rewrite.
# 2. androidboot.force_normal_boot, appended kernel-side when a legacy
#    bootloader sends skip_initramfs.  No-op when the flag is absent.
# 3. EROFS per-CPU decompression workers, as used by current Android images.
#    These live in erofs.config (one owner per subsystem); listed here only so
#    the A17 delta is readable in one place.
#
# Deliberately NOT set here:
#   CONFIG_INITRAMFS_IGNORE_SKIP_FLAG
#	Only helps when the ramdisk must win over skip_initramfs; enabling it
#	blind would change the boot path on every device.  Leave it off until a
#	device demonstrates it is needed.
#   CONFIG_KALLSYMS_ALL
#	Needed by syscall-table / kprobe hooking, which this tree does not use
#	(CONFIG_KSU_MANUAL_HOOK=y), and it would expose every data symbol in
#	/proc/kallsyms - the opposite of what SUSFS symbol hiding is for.
#   CONFIG_LD_DEAD_CODE_DATA_ELIMINATION
#	Size optimisation, not an Android 17 requirement, and it turns on
#	--gc-sections, which needs the linker-script audit done first.

CONFIG_AUDIT=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
