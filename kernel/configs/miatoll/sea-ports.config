# SEA+ ports & careful tuning — miatoll (SM6250 / Atoll)
# =====================================================
# Everything here is baked into vendor/xiaomi/miatoll_defconfig and the
# driver source; this fragment mirrors it for documentation (same pattern
# as haptics-sound.config).
#
# Provenance: feature list cross-checked against SEA+ Kernel (Asyanx,
# Kinesis-based) changelog for miatoll. MGLRU was excluded from the SEA set
# and ported separately afterwards — see the MGLRU section at the end.
# BORE vs CASS: CASS stays (decision) — BORE needs a 4.19→4.14 CFS port
# and fights CASS over fair.c; CASS is validated in our builds.

# ── CPUFreq: Reflex governor (firelzrd/reflex v0.4.0) ──
# schedutil + measured fast path for rising load. 4.14 adaptation:
# drivers/cpufreq/cpufreq_reflex.{c,h} + helper exports in
# kernel/sched/{fair,cpufreq,cpufreq_schedutil}.c.  DEFAULT governor since
# the defaults pass — the defconfig selects CONFIG_CPU_FREQ_DEFAULT_GOV_REFLEX
# (Kconfig choice "reflex", cpufreq_default_governor() override in
# cpufreq_reflex.c), so policies start on reflex at boot.  Per-policy switch
# still works both ways:
#   echo schedutil > /sys/devices/system/cpu/cpufreq/policyN/scaling_governor
# Tunables: /sys/devices/system/cpu/cpufreq/reflex/{rate_limit_us,
# latency_weight,version}.  Without an Energy Model the efficiency floor
# uses the cube-law model.
CONFIG_CPU_FREQ_GOV_REFLEX=y
CONFIG_CPU_FREQ_DEFAULT_GOV_REFLEX=y

# ── GPU: Simple GPU Algorithm (faux123/flar2) ──
# Simplified msm_adreno_tz level decision.  ENABLED by default since the
# defaults pass (simple_gpu_active = 1); disable at runtime or via the boot
# cmdline to get the stock tz decision back:
#   echo 0 > /sys/module/simple_gpu_algorithm/parameters/simple_gpu_activate
# Tunables: simple_laziness (default 4), simple_ramp_threshold (5000).
# Wired into drivers/devfreq/governor_msm_adreno_tz.c.

# ── Bluetooth: profile completion (additive, unused paths stay dormant) ──
# RFCOMM(+TTY): serial/car-kit accessories; BNEP: PAN tethering;
# HIDP: in-kernel HID keyboards/mice. WCN399x SLIMbus stack unchanged.
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_HIDP=y

# ── Wakelocks / suspend hygiene ──
# GC collects expired wakelocks (memory hygiene on long uptimes);
# autosleep adds /sys/power/autosleep for ROMs that drive suspend from
# wakelock state. PM_WAKELOCKS_LIMIT=0 (unlimited) kept — ROMs create
# many wakelocks and a cap would break them with -EINVAL.
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
CONFIG_PM_WAKELOCKS_GC=y

# ── Thermals: verified, deliberately untouched ──
# Already in place: THERMAL + OF + HWMON, step_wise default + user_space +
# low_limits, THERMAL_WRITABLE_TRIPS (mi_thermald needs it),
# CPU_THERMAL (cpu_cooling), QCOM_SPMI_TEMP_ALARM (PMIC overtemp),
# QCOM_SPMI_ADC5 (atoll tsens channels via DT), THERMAL_EMULATION
# (Kinesis-steal). No risky thermal changes made on purpose.

# ── KFENCE: low-overhead sampling memory-error detector ──
# Production-safe KASAN alternative (Google, upstream since 5.12). Ported
# from the LineageOS android_kernel_google_msm-4.14 KFENCE backport
# (same 4.14.357 base): mm/kfence/ + include/linux/kfence.h + hooks in
# slub/slab/slab_common/kmemleak/kasan + arm64 guard-page support
# (set_memory_valid) + fault.c page-fault hook. ~2 MB pinned pool,
# 255 guarded objects, one sampled allocation per 100 ms window.
# Runtime: /sys/kernel/debug/kfence/{stats,objects}; boot params
#   kfence.sample_interval= (0 disables), no_hash_pointers (verbose reports).
CONFIG_KFENCE=y
CONFIG_KFENCE_STATIC_KEYS=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
CONFIG_KFENCE_NUM_OBJECTS=255

# ── Oplus NandSwap: dedicated swap-area management ──
# Kernel-side port of the Oplus/realme atoll msm-4.14 NandSwap feature
# (the exact platform family of miatoll). Drivers + core at
# drivers/soc/oplus_nandswap/, public header include/linux/nandswap.h.
# Exposes /proc/nandswap/ (and /proc/nandswap_vnd/): fn_enable, dev_life,
# swap_ctl, swap_limit, life_protect, stat_info. Tags a swap device when
# swapon'ed with priority 2020 (SWAP_NANDSWAP_PRIO): only the nswapoutd
# kernel thread writes to it; normal reclaim skips it (and vice versa).
# Init-script userspace (init.oplus.nandswap.sh) drives /data/nandswap/
# swapfile with `swapon -p 2020` + `echo 1 > /proc/nandswap/fn_enable`.
# mm/ glue: scan_swap_map device filter, swap-slots-cache bypass for
# nswapoutd, swapin walker export (madvise), nswap_reclaim_page_list
# (vmscan) — rmap target_vma machinery already present via OPLUS_MM_HACKS.
CONFIG_NANDSWAP=y

# ── Multi-Gen LRU (MGLRU) ──
# Ported after the SEA set from the miatoll 4.14.357 backport series in
# heySaish/Void-Kernel (octasoul/kernel_xiaomi_sm6250 carries the identical
# series): the de-folio'd FROMLIST-v6 implementation + ANDROID fixes, 27
# commits incl. the BACKPORT/UPSTREAM lru-list prerequisites. Reclaim picks
# victims by generation (oldest first) instead of active/inactive ageing:
#   * page-table walks sample PTE young/accessed bits for anon+file pages
#     (arm64 arch_has_hw_pte_young() = cpu_has_hw_af, a real hardware bit);
#   * rmap look-around marks neighbouring PTEs (lru_gen_look_around);
#   * multi-memcg sorting keeps global reclaim fair across cgroups;
#   * thrashing prevention pins pages for min_ttl_ms before eviction.
# Kconfig: mm/Kconfig (LRU_GEN / LRU_GEN_ENABLED / LRU_GEN_STATS); page-flag
# spare bits are reserved through LRU_GEN_WIDTH/LRU_REFS_WIDTH defined in
# kernel/bounds.c and consumed by include/linux/page-flags-layout.h.
# CONFIG_LRU_GEN_ENABLED=y → active from boot; runtime kill switch + knobs:
#   echo 0 > /sys/kernel/mm/lru_gen/enabled       # bits: 0x1 core,
#                                                 # 0x2 page-table walks,
#                                                 # 0x4 non-leaf PMD (x86 only)
#   echo 200 > /sys/kernel/mm/lru_gen/min_ttl_ms  # 0 disables thrashing pin
# Debug: /sys/kernel/debug/lru_gen + /proc/PID/reclaim (CONFIG_LRU_GEN_STATS
# is off by default — historical per-generation stats have a memory cost).
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
