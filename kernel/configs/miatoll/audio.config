# Speaker & audio tuning — miatoll (SM6250 / Atoll)
# =================================================
# The audio graph on miatoll is split in two halves:
#
#   1. the ALSA/ASoC core in this tree, configured here, and
#   2. the QTI audio drivers in techpack/audio/4.0 (wcd937x codec, bolero
#      macros, WSA881x, and the TAS2562 smart speaker amplifier), which are
#      compiled into the kernel for ARCH_ATOLL and carry their own
#      configuration in techpack/audio/4.0/config/atollauto.conf
#      (CONFIG_SND_SOC_TAS2562=y, CONFIG_SND_SOC_WCD937X=y,
#      CONFIG_SND_SOC_WSA881X=y, CONFIG_SOUNDWIRE=y, ...).
#
# Because the amp/codec half is configured there and not by Kconfig, nothing
# in this fragment can (or should) name those symbols - what it does is make
# sure the ALSA core underneath them is built the way the drivers expect:
#
#   * SND_HRTIMER: period timing on an hrtimer instead of jiffies.  This is
#     what keeps 24-bit/48 kHz playback and the compressed-offload path
#     glitch-free on a kernel built with HZ=300; it is also what the
#     "haptics via audio" and low-latency game paths need.
#   * SND_DYNAMIC_MINORS + SND_MAX_CARDS=32: the atoll audio graph registers
#     many PCM/substream devices (deep buffer, low latency, compress
#     offload, voice, ultrasound).  Without dynamic minors the static
#     ALSA minor space runs out and late-probing devices fail to register.
#   * SND_SOC_COMPRESS + SND_COMPRESS_OFFLOAD: hardware/DSP decoding for
#     compressed streams, so the CPU (and therefore the thermal budget)
#     stays out of music playback.
#   * SND_USB_AUDIO: USB-C DACs / headsets, the usual companion to the
#     speaker path.
#   * SND_VERBOSE_PROCFS stays on so the routing/state of the speaker amp
#     can actually be inspected from userspace.
#
# Deliberately not enabled: SND_DEBUG / SND_DEBUG_VERBOSE (they add locking
# and per-call tracing to every PCM operation) and the OSS emulation.

# ── ALSA / ASoC core ──
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_I2C_AND_SPI=y
CONFIG_SND_SOC_COMPRESS=y
CONFIG_SND_COMPRESS_OFFLOAD=y

# ── Timing / device plumbing ──
CONFIG_SND_HRTIMER=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_DYNAMIC_MINORS=y
CONFIG_SND_MAX_CARDS=32

# ── Jacks (headset / USB-C detection feeds the mixer) ──
CONFIG_SND_JACK=y
CONFIG_SND_JACK_INPUT_DEV=y

# ── External audio ──
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# ── Introspection ──
CONFIG_SND_PROC_FS=y
CONFIG_SND_VERBOSE_PROCFS=y
# CONFIG_SND_DEBUG is not set
# CONFIG_SND_VERBOSE_PRINTK is not set
# CONFIG_SND_OSSEMUL is not set
