# KernelSU-Next v3.4.1 (driver source: kernelSU/, linked as drivers/kernelsu)
# ----------------------------------------------------------------------
# KernelSU-Next hooks the kernel with kprobes/kretprobes on this
# non-GKI 4.14 tree.  The vendor defconfig ships with KPROBES disabled, so
# it must be enabled here or CONFIG_KSU (depends on KPROBES && EXT4_FS)
# silently drops to n.

CONFIG_KPROBES=y
CONFIG_KRETPROBES=y

CONFIG_KSU=y
