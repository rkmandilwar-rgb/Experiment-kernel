# KernelSU Next (non-GKI / manual hooks)
# ======================================
# Kernel-level root for this non-GKI 4.14 tree.  The driver is vendored at
# KernelSU-Next/ (KernelSU-Next/KernelSU-Next@legacy, see
# KernelSU-Next/README.kernel.md) and compiled in via drivers/kernelsu.
#
# Hook mode: MANUAL, on purpose.
#   * Kprobe hooks ("Kprobes" / "tracepoint+kretprobe" in the KSU Kconfig)
#     are documented as "should not be used on kernel below 5.10", and many
#     4.x kernels have buggy kprobes that silently break root.
#   * Syscall-table patching needs >= 4.17 (pt_regs syscall ABI).
#   * Manual hooks are the supported non-GKI path: the call sites are the
#     scope-minimized VFS hooks in fs/exec.c (do_execveat_common), fs/open.c
#     (faccessat), fs/read_write.c (vfs_read), fs/stat.c (vfs_statx),
#     kernel/reboot.c (supercall) and drivers/input/input.c (safe mode).
#     They are kept in the exact shape susfs4ksu's non-GKI patches expect,
#     so backporting SUSFS later is a patch -p1 away (see the README).
#
# Note CONFIG_KPROBES stays available (the eBPF pack wants tracing attach
# types); KSU simply does not use it for hooking here.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
