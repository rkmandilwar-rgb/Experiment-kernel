# Thermal management — miatoll (SM6250 / Atoll)
# =============================================
# The goal here is a *complete and reachable* thermal stack: every mitigation
# path the atoll device tree actually wires up must be compiled in, the trips
# stay writable so userspace (thermal-engine / a ROM's own HAL) can retune
# them, and nothing that can never bind is built.
#
# Layers, from the sensor up:
#
#   1. sensors      - TSENS (drivers/thermal/msm-tsens.c + tsens2xxx), the
#                     PMIC die temperature alarm (spmi-temp-alarm on both
#                     pm6150 and pm6150l) and the PM6150L ADC thermal
#                     monitor (adc-tm5, three channels: quiet/backlight/pa).
#   2. core         - thermal zone + OF parsing + hwmon export + the
#                     step_wise / low_limits / user_space governors.
#                     step_wise is the default because it is the governor the
#                     atoll trip tables are written for; low_limits is
#                     required by the aoss-0-lowf zone (it raises the floor
#                     instead of throttling, for cold-boot reliability).
#   3. cooling      - cpufreq (CPU_THERMAL) on all eight CPUs,
#                     devfreq/GPU (DEVFREQ_THERMAL), the QMI cooling devices
#                     for modem/pa/adsp/cdsp, the RPMh/AOP regulator cooling
#                     devices for cx/mx, and the BCL (brown-out current
#                     limit) drivers that cut CPU/GPU hard when the battery
#                     cannot sustain a transient.
#   4. hardware     - LMH DCVS (qcom,msm-hw-limits on cpucc) is a hardware
#                     limiter: it keeps working even if the software stack is
#                     late or wedged, so it is the last line of defence.
#
# Skin-temperature mitigation: the atoll device tree defines a step_wise
# "quiet-therm-step" zone (46/47/48/50/58 C) but the stock Xiaomi IDP DTS
# disables it, leaving kernel-side skin throttling to userspace.  The kernel
# re-enables it for the miatoll variants (see cust-atoll-thermal.dtsi), so the
# device stays protected with or without a thermal HAL: at 47 C the two big
# cores cap at ~1.7 GHz and at 50 C all cores cap at ~1.5 GHz -- a mild cap,
# not a shutdown, and it also keeps sustained power (and therefore battery
# current) down when the phone is hot.
#
# Options that are deliberately NOT built (all verified dead on this DT):
#   * CLOCK_THERMAL - no clock-cooling-device node exists in any atoll DTS
#     and clock_cooling_register() has no caller in this tree.  The modem/GPU
#     rails are cooled through the RPMh/AOP regulator cooling devices instead.
#   * THERMAL_GOV_FAIR_SHARE / THERMAL_GOV_BANG_BANG /
#     THERMAL_GOV_POWER_ALLOCATOR - no atoll thermal zone requests any of
#     these governors, so building them would only add unreachable code.
#   * QTI_BUS_SCALING_COOLING_DEVICE - no qcom,bus-scaling node on atoll.
#   * QTI_CX_IPEAK_COOLING_DEVICE - qcom,cx-ipeak exists only on
#     sm6150/sdmmagpie/sdm660/trinket; atoll has no such node (the camera DTS
#     reference is commented out).
#   * MSM_BCL_PERIPHERAL_CTL - it binds qcom,msm-bcl-lmh, which only exists in
#     pm660.dtsi.  atoll uses the PMIC5 BCL drivers below instead.
# They are pinned off explicitly so a future defconfig or upstream sync
# cannot silently bring dead drivers (and their probe paths) back.
#
# Other deliberate choices:
#   * THERMAL_WRITABLE_TRIPS stays on so a ROM can tune trips from userspace;
#     the trip tables themselves are DTS-owned and are not touched here.
#   * THERMAL_EMULATION stays off: it is a debug facility that lets userspace
#     lie about temperatures, which is the last thing a phone should ship with.
#   * THERMAL_EMERGENCY_POWEROFF_DELAY_MS stays 0 (act immediately).

# ── Core thermal framework ──
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=0
# CONFIG_THERMAL_EMULATION is not set

# ── Governors: the three the atoll trip tables use (plus the default) ──
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
# CONFIG_THERMAL_DEFAULT_GOV_FAIR_SHARE is not set
# CONFIG_THERMAL_DEFAULT_GOV_USER_SPACE is not set
# CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR is not set
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_THERMAL_GOV_LOW_LIMITS=y

# ── Unreachable governors: no atoll zone asks for them ──
# CONFIG_THERMAL_GOV_FAIR_SHARE is not set
# CONFIG_THERMAL_GOV_BANG_BANG is not set
# CONFIG_THERMAL_GOV_POWER_ALLOCATOR is not set

# ── Cooling devices: CPU, GPU/devfreq, regulators, BCL ──
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_REGULATOR_COOLING_DEVICE=y
# CONFIG_CLOCK_THERMAL is not set

# ── Sensors ──
CONFIG_THERMAL_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# ── QTI mitigation / cooling drivers ──
CONFIG_QTI_THERMAL_LIMITS_DCVS=y
CONFIG_QTI_VIRTUAL_SENSOR=y
CONFIG_QTI_AOP_REG_COOLING_DEVICE=y
CONFIG_QTI_QMI_COOLING_DEVICE=y
CONFIG_QTI_QMI_SENSOR=y
CONFIG_QTI_ADC_TM=y
# QTI_RPM_SMD_COOLING_DEVICE would need CONFIG_MSM_RPM_SMD, which atoll
# (an RPMh platform) does not use - the equivalent mitigation here is the
# AOP regulator cooling device above.
# CONFIG_QTI_BUS_SCALING_COOLING_DEVICE is not set
# CONFIG_QTI_CX_IPEAK_COOLING_DEVICE is not set

# ── Battery current limit: last line of defence against brown-out ──
CONFIG_QTI_BCL_PMIC5=y
CONFIG_QTI_BCL_SOC_DRIVER=y
# CONFIG_MSM_BCL_PERIPHERAL_CTL is not set
