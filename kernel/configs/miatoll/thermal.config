# Thermal management — miatoll (SM6250 / Atoll)
# =============================================
# The goal here is a *complete* thermal stack, not a more aggressive one:
# every mitigation path the SoC exposes should be reachable, the trips have
# to be writable so userspace (thermal-engine / a ROM's own HAL) can retune
# them, and the default governor must be a well-behaved one.
#
# Layers, from the sensor up:
#
#   1. sensors      - TSENS (drivers/thermal/msm-tsens.c), the PMIC die
#                     temperature alarm (spmi-temp-alarm), the QMI sensor
#                     service (qmi_sensors.c, reads the sensors owned by the
#                     ADSP) and the ADC thermal monitor.
#   2. core         - thermal zone + OF parsing + hwmon export + the
#                     low_limits / step_wise / bang_bang / user_space
#                     governors.  step_wise is the default because it is the
#                     governor the atoll trip tables are written for.
#   3. cooling      - cpufreq (CPU_THERMAL), devfreq/GPU (DEVFREQ_THERMAL),
#                     generic clock cooling (CLOCK_THERMAL), the RPM-SMD /
#                     AOP regulator paths and the BCL (brown-out current
#                     limit) drivers that cut the CPU/GPU hard when the
#                     battery cannot sustain a transient.
#   4. virtual      - QTI_VIRTUAL_SENSOR exposes aggregate zones (e.g. "cpu
#                     total power") so mitigations act on the package rather
#                     than on one sensor, QTI_QMI_COOLING_DEVICE lets the
#                     ADSP ask for mitigation.
#
# Notes on the deliberately conservative choices:
#   * THERMAL_WRITABLE_TRIPS stays on so a ROM can tune trips from
#     userspace; the trip tables themselves are DTS-owned and are not
#     touched by this fragment.
#   * THERMAL_EMULATION stays off: it is a debug facility that lets
#     userspace lie about temperatures, which is the last thing a phone
#     should ship with.
#   * THERMAL_EMERGENCY_POWEROFF_DELAY_MS stays 0 (act immediately).
#   * CLOCK_THERMAL is enabled because the atoll DTS references clock
#     cooling devices on the modem/GPU rails; without it those zones have
#     no cooling device to act on and mitigate by throttling everything.

# ── Core thermal framework ──
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_EMERGENCY_POWEROFF_DELAY_MS=0
# CONFIG_THERMAL_EMULATION is not set

# ── Default + available governors ──
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
# CONFIG_THERMAL_DEFAULT_GOV_FAIR_SHARE is not set
# CONFIG_THERMAL_DEFAULT_GOV_USER_SPACE is not set
# CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR is not set
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_LOW_LIMITS=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_THERMAL_GOV_BANG_BANG=y
# fair_share / power_allocator are built in as well: some zone bindings in
# the atoll DTS ask for them by name, and an unbound governor is a zone that
# cannot mitigate at all.
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# ── Cooling devices: CPU, GPU/devfreq, clocks, regulators ──
CONFIG_CPU_THERMAL=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_CLOCK_THERMAL=y
CONFIG_REGULATOR_COOLING_DEVICE=y

# ── Sensors ──
CONFIG_THERMAL_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# ── QTI mitigation / cooling drivers ──
CONFIG_QTI_THERMAL_LIMITS_DCVS=y
CONFIG_QTI_VIRTUAL_SENSOR=y
CONFIG_QTI_AOP_REG_COOLING_DEVICE=y
CONFIG_QTI_QMI_COOLING_DEVICE=y
CONFIG_QTI_QMI_SENSOR=y
CONFIG_QTI_ADC_TM=y
CONFIG_QTI_BUS_SCALING_COOLING_DEVICE=y
# QTI_RPM_SMD_COOLING_DEVICE would need CONFIG_MSM_RPM_SMD, which atoll
# (an RPMh platform) does not use - the equivalent mitigation here is the
# AOP regulator cooling device above.
CONFIG_QTI_CX_IPEAK_COOLING_DEVICE=y

# ── Battery current limit: last line of defence against brown-out ──
CONFIG_QTI_BCL_PMIC5=y
CONFIG_QTI_BCL_SOC_DRIVER=y
CONFIG_MSM_BCL_PERIPHERAL_CTL=y
